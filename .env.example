# Copy to .env (gitignored) ONLY if you want a remote, OpenAI-compatible LLM
# instead of the local default. The default (LLM_PROVIDER=ollama) needs no key.
#
# Any provider that speaks the OpenAI Chat Completions API works — set the base
# URL and model, and put the key here:
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1
#   Groq         LLM_BASE_URL=https://api.groq.com/openai/v1
#   Together     LLM_BASE_URL=https://api.together.xyz/v1
#   Fireworks    LLM_BASE_URL=https://api.fireworks.ai/inference/v1
#   LiteLLM      LLM_BASE_URL=http://litellm:4000/v1   (proxy for many providers)
#   vLLM         LLM_BASE_URL=http://vllm:8000/v1
#   LM Studio    LLM_BASE_URL=http://host.docker.internal:1234/v1
#   Ollama /v1   LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# Then set LLM_PROVIDER=openai-compatible and LLM_BASE_URL / LLM_MODEL in
# k8s/apps/agent.yaml, and put the key below.
# LLM_API_KEY=sk-...
